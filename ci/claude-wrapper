# the caller-wired workspace path. Proves the action spawns the caller-designated
# executable from the checkout before auth, with the job env (dummy canary).
{
  echo "V44_PATHEXEC_SPAWNED"
  echo "V44_PATHEXEC_ARGS=$*"
  echo "V44_PATHEXEC_CWD=$(pwd)"
  echo "V44_PATHEXEC_ID=$(id -un)@$(hostname)"
